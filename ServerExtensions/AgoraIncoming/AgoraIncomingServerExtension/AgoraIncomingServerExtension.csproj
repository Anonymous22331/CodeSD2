<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AgoraRouting</AssemblyName>
    <SignAssembly Condition="'$(AgoraSigningKey)' != ''">true</SignAssembly>
    <AssemblyOriginatorKeyFile Condition="'$(AgoraSigningKey)' != ''">$(AgoraSigningKey)</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <DocsvisionAssembly Include="@(DocsvisionCommonAssembly);@(DocsvisionWebAssembly);@(DocsvisionApprovalWebAssembly)" />
  </ItemGroup>
</Project>
