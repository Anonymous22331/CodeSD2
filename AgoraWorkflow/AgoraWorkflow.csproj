<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WorkflowHandler)' != ''">
    <AssemblyName>$(WorkflowHandler)</AssemblyName>
    <OutputPath>bin/$(Configuration)/$(WorkflowHandler)/</OutputPath>
    <IntermediateOutputPath>obj/$(Configuration)/$(WorkflowHandler)/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(WorkflowHandler).cs" Condition="'$(WorkflowHandler)' != ''" />
    <DocsvisionAssembly Include="@(DocsvisionCommonAssembly);@(DocsvisionWorkflowAssembly)" />
  </ItemGroup>
  <Target Name="ValidateWorkflowHandler" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(WorkflowHandler)' != 'ReadIncomingRoute' and '$(WorkflowHandler)' != 'ReadReviewDecision' and '$(WorkflowHandler)' != 'RunIncomingFollowUp' and '$(WorkflowHandler)' != 'ArchiveIncomingLetters' and '$(WorkflowHandler)' != 'SendOverdueReviewReport'"
           Text="Select a supported WorkflowHandler. Docsvision expects a separate assembly for each DVScriptHost.DVScript class." />
  </Target>
</Project>
